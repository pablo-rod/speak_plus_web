# ============================================================
#  SPEAK+ — .gitignore
# ============================================================

# ── Variáveis de ambiente (NUNCA commitar) ──────────────────
.env
.env.local
.env.production
.env.development

# ── Dependências ────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Build outputs ───────────────────────────────────────────
dist/
build/
out/
.next/
.nuxt/

# ── Logs ────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Sistema operacional ─────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Editores ────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ── Cache ───────────────────────────────────────────────────
.cache/
.parcel-cache/
.eslintcache

# ── Config local gerado ─────────────────────────────────────
config.local.js

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
!.env.example
